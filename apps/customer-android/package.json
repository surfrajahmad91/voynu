{
  "name": "@voynu/customer-android",
  "version": "1.0.0",
  "private": true,
  "description": "Capacitor Android shell for the VOYNU customer app (loads the hosted Next.js app)",
  "scripts": {
    "sync": "cap sync android",
    "open": "cap open android",
    "run": "cap run android",
    "build:debug": "cd android && ./gradlew assembleDebug",
    "build:release": "cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "typescript": "^7.0.2"
  }
}
